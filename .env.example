# Template environment variables.
# Copy this file to .env before starting the application:
#     cp .env.example .env
# Replace EVERY value below with your own secrets (e.g. `openssl rand -hex 16`).

# Project case: healthsync | marketplace
CASE=marketplace

SECRET_KEY=change-me

# Database (MySQL 8.4)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=app

# Administrator account created on startup
ADMIN_EMAIL=admin@template.test
ADMIN_PASSWORD=change-me

# Password of the test accounts defined in cases/<case>/case.json
SEED_PASSWORD=change-me

# C++ robot
WORKER_TOKEN=change-me
WORKER_INTERVAL_SECONDS=60

# External API. If EXTERNAL_API_BASE_URL is empty the simulator is used.
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=simulated
